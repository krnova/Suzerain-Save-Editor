<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SuzerainSaveEditor.UI.Views"
        x:Class="SuzerainSaveEditor.App.Views.MainWindow"
        Icon="/Assets/app-icon.ico"
        Title="{Binding WindowTitle}"
        Width="950" Height="700"
        MinWidth="700" MinHeight="500">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <Panel DragDrop.AllowDrop="True" Background="Transparent">
        <views:MainView />

        <Border Name="DropOverlay"
                IsVisible="False"
                Background="{DynamicResource OverlayBackground}"
                ZIndex="200"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <!-- top divider -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <Border Height="1" Width="60"
                            Background="{DynamicResource BorderDefault}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="&#x25C6;"
                               FontSize="10"
                               Foreground="{DynamicResource AccentPrimary}"
                               VerticalAlignment="Center" />
                    <Border Height="1" Width="60"
                            Background="{DynamicResource BorderDefault}"
                            VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="DROP SAVE FILE HERE"
                           FontSize="22"
                           FontWeight="Light"
                           LetterSpacing="4"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentPrimary}" />

                <!-- bottom divider -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <Border Height="1" Width="60"
                            Background="{DynamicResource BorderDefault}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="&#x25C6;"
                               FontSize="10"
                               Foreground="{DynamicResource AccentPrimary}"
                               VerticalAlignment="Center" />
                    <Border Height="1" Width="60"
                            Background="{DynamicResource BorderDefault}"
                            VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text=".json files only"
                           FontSize="13"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
