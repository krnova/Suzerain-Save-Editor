<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SuzerainSaveEditor.Android.Views.AndroidUnsavedChangesView"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#AA000000">

    <Border Background="{DynamicResource BgBase}"
            CornerRadius="8"
            Padding="20"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Spacing="16">
            <TextBlock Text="You have unsaved changes. What would you like to do?"
                       TextWrapping="Wrap"
                       FontSize="14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Padding="16,8" Click="OnCancel" />
                <Button Content="Discard" Padding="16,8" Click="OnDiscard" />
                <Button Content="Save" Padding="16,8" Classes="accent" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
