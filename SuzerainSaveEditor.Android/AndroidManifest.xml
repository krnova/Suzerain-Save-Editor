<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.suzerain.saveeditor">
    <uses-sdk android:minSdkVersion="29" />
    <application android:label="Suzerain Save Editor" android:allowBackup="true"></application>

    <!--
      Intentionally no storage permissions here. File access goes through
      FileDialogService -> TopLevel.StorageProvider (Storage Access Framework),
      which needs none. Declaring WRITE_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE
      would be mostly non-functional above API 29 scoped storage anyway, and
      MANAGE_EXTERNAL_STORAGE specifically requires separate Play Console review
      to ship - don't add it without a real reason to.
    -->
</manifest>
